{
  "name": "@dash/desktop",
  "productName": "DASH",
  "version": "0.1.0",
  "license": "SEE LICENSE IN LICENSE",
  "description": "Privacy-first desktop browser. Built for you.",
  "author": {
    "name": "Bibek Bista"
  },
  "homepage": "https://github.com/bibekbista0405/Dash-Browser",
  "repository": {
    "type": "git",
    "url": "https://github.com/bibekbista0405/Dash-Browser.git"
  },
  "main": "dist-electron/main/index.js",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/restore-dev-sqlite3.mjs",
    "dev": "vite",
    "build": "vite build",
    "start": "npm run build && electron .",
    "dist": "node scripts/dist.mjs",
    "dist:win": "node scripts/dist.mjs win",
    "dist:portable": "node scripts/dist.mjs portable",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.main.json",
    "native:electron": "node scripts/native-electron.mjs",
    "ui-check": "node scripts/ui-check.mjs",
    "verify:signatures": "node scripts/verify-signatures.mjs",
    "check:artifacts": "node scripts/check-artifacts.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "electron-store": "^10.0.0",
    "electron-updater": "^6.8.9",
    "extract-zip": "^2.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@dash/browser-core": "*",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.5.4",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.4.0",
    "@typescript-eslint/parser": "^8.4.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "electron": "^32.0.1",
    "electron-builder": "^25.0.5",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "playwright-core": "^1.65.0",
    "postcss": "^8.4.45",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.3",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^2.1.9"
  },
  "build": {
    "appId": "com.bibekbista.dash",
    "productName": "DASH",
    "copyright": "Copyright \u00a9 2026 Bibek Bista",
    "electronVersion": "32.3.3",
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "dist-electron/**/*",
      "resources/**/*",
      "package.json",
      "node_modules/**/*",
      "!node_modules/@dash/**"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "DASH",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": true,
      "shortcutName": "DASH",
      "uninstallDisplayName": "DASH",
      "deleteAppDataOnUninstall": false,
      "artifactName": "${productName} Setup ${version}.${ext}",
      "runAfterFinish": true,
      "installerSidebar": "installerSidebar.bmp",
      "uninstallerSidebar": "uninstallerSidebar.bmp",
      "installerHeader": "installerHeader.bmp",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico",
      "license": "license.txt",
      "include": "installer.nsh",
      "menuCategory": false,
      "displayLanguageSelector": false
    },
    "mac": {
      "icon": "resources/icon.icns",
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "icon": "resources/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Network",
      "executableName": "dash"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://updates.invalid/dash"
      }
    ],
    "portable": {
      "artifactName": "${productName} ${version}.${ext}",
      "splashImage": "resources/portableSplash.bmp"
    }
  }
}
