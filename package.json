{
  "name": "dash-monorepo",
  "version": "0.1.0",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "description": "DASH — a privacy-first browser platform. apps/desktop is the Electron implementation today; packages/browser-core holds platform-independent domain logic shared by every future platform (Android, iOS).",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/desktop",
    "build": "npm run build --workspace=apps/desktop",
    "start": "npm run start --workspace=apps/desktop",
    "dist": "npm run dist --workspace=apps/desktop",
    "dist:win": "npm run dist:win --workspace=apps/desktop",
    "dist:portable": "npm run dist:portable --workspace=apps/desktop",
    "typecheck": "npm run typecheck --workspace=packages/browser-core && npm run typecheck --workspace=apps/desktop",
    "lint": "npm run lint --workspace=apps/desktop",
    "native:electron": "npm run native:electron --workspace=apps/desktop",
    "ui-check": "npm run ui-check -w apps/desktop",
    "verify:signatures": "npm run verify:signatures --workspace=apps/desktop --",
    "check:artifacts": "npm run check:artifacts --workspace=apps/desktop"
  }
}
